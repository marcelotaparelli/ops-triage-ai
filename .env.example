# OPS TRIAGE AI — development template (replace placeholders; do not commit secrets)
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
TRIAGE_CLASSIFIER=deterministic
NODE_ENV=development
# Required in production. Keep unset locally unless testing authentication.
# TRIAGE_API_KEY=
HTTP_BODY_LIMIT_BYTES=32768
TRIAGE_MAX_CONCURRENCY=8
REQUEST_TIMEOUT_MS=310000
STALE_RUN_THRESHOLD_MS=600000

# Required when TRIAGE_CLASSIFIER=ollama or TRIAGE_CLASSIFIER=hybrid
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_S
OLLAMA_TIMEOUT_MS=120000

# Usadas pelo compose.yaml (PostgreSQL somente)
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops_dev_password
POSTGRES_DB=ops_triage
