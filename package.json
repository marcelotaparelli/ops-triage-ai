{
  "name": "ops-triage-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "eval:dev": "bun scripts/evaluate-triage.ts datasets/triage-dev.jsonl",
    "eval:heldout": "bun scripts/evaluate-triage.ts datasets/triage-eval.jsonl",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "eslint": "^10.10.0",
    "prisma": "7.10.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
